# Copy to `.env` or `.env.local` and fill in values. Do not commit real secrets.
# See README.md for Netlify production variables.

# --- Vite (client) — values are embedded in the built JS; restrict keys in each provider’s dashboard ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Open Charge Map — optional for `npm run dev` without Netlify (direct browser calls).
# For production, prefer setting OCM_API_KEY only on Netlify (see README) so the key is not shipped to clients.
VITE_OCM_API_KEY=

# --- Netlify Functions (server-only; set in Netlify: Site settings → Environment variables) ---
# Used by netlify/functions/fetch-fuel-stations.ts (and may match your Google Cloud key).
# GOOGLE_MAPS_API_KEY=

# Used by netlify/functions/fetch-openchargemap.ts — recommended for production EV data.
# OCM_API_KEY=
